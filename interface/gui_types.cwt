types = {
	## type_key_filter = guiTypes
	type[gui_type] = {
		path = "game/interface"
		severity = warning
	}
}

enums = {
	enum[gui_orientation] = {
		UPPER_LEFT
		UPPER_RIGHT
		LOWER_LEFT
		LOWER_RIGHT
		CENTER_LEFT
		CENTER_RIGHT
		CENTER
		CENTER_UP
		CENTER_DOWN
		upper_left
		upper_right
		lower_left
		lower_right
		center_left
		center_right
		center
		center_up
		center_down
	}
	enum[gui_container_orientation] = {
		UPPER_LEFT
		UPPER_RIGHT
		LOWER_LEFT
		LOWER_RIGHT
		CENTER
		CENTER_UP
		CENTER_DOWN
		upper_left
		upper_right
		lower_left
		lower_right
		center
		center_up
		center_down
	}
	enum[gui_animation] = {
		none
		linear
		accelerated
		decelerated
		smoothstep
	}
	enum[gui_text_format] = {
		left
		center
		centre
		right
	}
	enum[gui_vertical_alignment] = {
		top
		center
		centre
		bottom
	}
}

