types = {
	## type_key_filter = { spriteType quadTextureSprite corneredTileSpriteType frameAnimatedSpriteType textSpriteType progressbartype resizeableSpriteType tileSpriteType maskedShieldType PieChartType LineChartType }
	type[sprite] = {
		name_field = "name"
		path = "game/interface"
		skip_root_key = spriteTypes
		severity = warning
		## type_key_filter = spriteType
		subtype[normal] = {}
		## type_key_filter = quadTextureSprite
		subtype[quad_texture] = {}
		## type_key_filter = corneredTileSpriteType
		subtype[cornered_tile_sprite] = {}
		## type_key_filter = frameAnimatedSpriteType
		subtype[frame_animated_sprite] = {}
		## type_key_filter = textSpriteType
		subtype[text_sprite] = {}
		## type_key_filter = progressbartype
		subtype[progressbar] = {}
		## type_key_filter = resizeableSpriteType
		subtype[resizeable_sprite] = {}
		## type_key_filter = tileSpriteType
		subtype[tile_sprite] = {}
		## type_key_filter = maskedShieldType
		subtype[masked_shield] = {}
		## type_key_filter = PieChartType
		subtype[pie_chart] = {}
		## type_key_filter = LineChartType
		subtype[line_chart] = {}
	}
}

